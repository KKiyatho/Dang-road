rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, delete: if owns(userId);
      allow create, update: if owns(userId)
        && request.resource.data.keys().hasOnly([
          'dogName', 'dogSize', 'dogEnergy', 'dogSociality', 'updatedAt'
        ]);

      match /walks/{walkId} {
        allow read, delete: if owns(userId);
        allow create, update: if owns(userId)
          && request.resource.data.keys().hasOnly([
            'routeName', 'distanceKm', 'minutes', 'dogName', 'notes',
            'startedAt', 'createdAt'
          ])
          && request.resource.data.routeName is string
          && request.resource.data.routeName.size() > 0
          && request.resource.data.routeName.size() <= 100
          && request.resource.data.distanceKm is number
          && request.resource.data.distanceKm >= 0
          && request.resource.data.distanceKm <= 200
          && request.resource.data.minutes is int
          && request.resource.data.minutes >= 0
          && request.resource.data.minutes <= 1440;
      }
    }

    match /meetups/{meetupId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          'creatorId', 'title', 'region', 'startsAt', 'capacity',
          'participantIds', 'status', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'creatorId', 'title', 'region', 'startsAt', 'capacity',
          'participantIds', 'status', 'createdAt'
        ])
        && request.resource.data.creatorId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 60
        && request.resource.data.region is string
        && request.resource.data.region.size() > 0
        && request.resource.data.region.size() <= 40
        && request.resource.data.startsAt is timestamp
        && request.resource.data.capacity is int
        && request.resource.data.capacity >= 2
        && request.resource.data.capacity <= 8
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() == 1
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt is timestamp;

      allow update: if signedIn()
        && resource.data.status == 'open'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['participantIds'])
        && request.auth.uid in request.resource.data.participantIds
        && !(request.auth.uid in resource.data.participantIds)
        && request.resource.data.participantIds.size()
          == resource.data.participantIds.size() + 1
        && request.resource.data.participantIds.size() <= resource.data.capacity;

      allow delete: if signedIn() && resource.data.creatorId == request.auth.uid;
    }
  }
}