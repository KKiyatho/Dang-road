  function selectCourse(courseId) {
    // 1. Highlight clicked card
    document.querySelectorAll('.course-card').forEach(card => {
      card.classList.remove('shadow-md', 'bg-gradient-to-r', 'from-surface-container-lowest', 'to-surface-container-low');
      card.classList.add('shadow-sm');
    });

    const activeCard = document.getElementById(`card-${courseId}`);
    if (activeCard) {
      activeCard.classList.remove('shadow-sm');
      activeCard.classList.add('shadow-md', 'bg-gradient-to-r', 'from-surface-container-lowest', 'to-surface-container-low');
    }

    // 2. Update Modal Contents
    const data = courseData[courseId];
    if (!data) return;

    document.getElementById('modal-title').textContent = data.title;
    document.getElementById('modal-subtitle').textContent = data.subtitle;

    const modal = document.getElementById('course-briefing-modal');
    modal.classList.remove('translate-y-full', 'opacity-0');

    // 3. Update Vector Polyline Visuals
    const activeStream = document.getElementById('route-beomeo-stream');
    const parkPath = document.getElementById('route-beomeo-park');
    const shincheonPath = document.getElementById('route-shincheon-river');

    if (courseId === 'beomeo-stream') {
      activeStream.setAttribute('stroke-width', '10');
      activeStream.setAttribute('stroke', 'url(#activeRouteGlow)');
      parkPath.setAttribute('stroke-width', '5');
      parkPath.setAttribute('opacity', '0.5');
    } else if (courseId === 'beomeo-park') {
      parkPath.setAttribute('stroke-width', '10');
      parkPath.setAttribute('stroke', '#00652c');
      parkPath.setAttribute('opacity', '1');
      activeStream.setAttribute('stroke-width', '5');
      activeStream.setAttribute('stroke', '#79db8d');
    } else if (courseId === 'shincheon-river') {
      shincheonPath.setAttribute('stroke-width', '10');
      shincheonPath.setAttribute('stroke', '#00652c');
      shincheonPath.setAttribute('opacity', '1');
      activeStream.setAttribute('stroke-width', '5');
    }
  }

  function toggleBriefingModal() {
    const content = document.getElementById('modal-expandable-content');
    const icon = document.getElementById('modal-toggle-icon');
    isModalCollapsed = !isModalCollapsed;

    if (isModalCollapsed) {
      content.classList.add('hidden');
      icon.textContent = 'expand_less';
    } else {
      content.classList.remove('hidden');
      icon.textContent = 'expand_more';
    }
  }

  function toggleSaveCourse() {
    isSaved = !isSaved;
    const icon = document.getElementById('save-icon');
    const label = document.getElementById('save-label');
    const btn = document.getElementById('btn-save-course');

    if (isSaved) {
      icon.textContent = 'bookmark';
      icon.classList.add('text-primary');
      icon.setAttribute('style', "font-variation-settings: 'FILL' 1;");
      label.textContent = '저장됨';
      btn.classList.add('bg-on-primary-container');
    } else {
      icon.textContent = 'bookmark_border';
      icon.classList.remove('text-primary');
      icon.removeAttribute('style');
      label.textContent = '코스 저장';
      btn.classList.remove('bg-on-primary-container');
    }
  }

  function showPinTip(title, desc, iconName) {
    const toast = document.getElementById('pin-popup-toast');
    document.getElementById('pin-toast-title').textContent = title;
    document.getElementById('pin-toast-desc').textContent = desc;
    document.getElementById('pin-toast-icon').textContent = iconName;
    toast.classList.remove('hidden');
    toast.classList.add('flex');
  }

  function hidePinTip() {
    const toast = document.getElementById('pin-popup-toast');
    toast.classList.add('hidden');
    toast.classList.remove('flex');
  }

  function startNavigation() {
